---
layout: base.njk
title: Tags
permalink: /tags/
eleventyExcludeFromCollections: true
---
<header class="page-head">
  <h1>Tags</h1>
</header>

<ul class="line-list">
  {% for entry in collections.tagList %}
    <li>
      <span class="meta-date">#{{ entry.tag | slugify }}</span>
      <a href="#{{ entry.tag | slugify }}">{{ entry.tag }}</a>
      <span class="meta-tail">{{ entry.posts.length }} post{% if entry.posts.length != 1 %}s{% endif %}</span>
    </li>
  {% endfor %}
</ul>

{% for entry in collections.tagList %}
<section class="year-group" id="{{ entry.tag | slugify }}">
  <h2>{{ entry.tag }}</h2>
  <ul class="line-list">
    {% for post in entry.posts %}
      <li>
        <span class="meta-date">{{ post.date | ymd }}</span>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
        <span class="meta-tail"></span>
      </li>
    {% endfor %}
  </ul>
</section>
{% endfor %}
