<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {% set isHome = (page.url == "/") %}
  {% set pageTitle = title or site.title %}
  {% set pageDesc = description or site.description %}

  {% if isHome %}
    <title>{{ site.title }} — {{ site.tagline }}</title>
  {% else %}
    <title>{{ pageTitle }} · {{ site.title }}</title>
  {% endif %}

  <meta name="description" content="{{ pageDesc }}">

  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }}" href="/feed.xml">
  <link rel="icon" href="/favicon.ico">

  <meta property="og:type" content="{% if layout == 'post.njk' %}article{% else %}website{% endif %}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDesc }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if image %}<meta property="og:image" content="{{ site.url }}{{ image }}">{% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap">

  <link rel="stylesheet" href="/assets/css/main.css">
</head>
